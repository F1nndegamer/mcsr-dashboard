# ---------------------------------------------------------------------------
# mcsr-1000-runs configuration
# Copy to `.env.local` (git-ignored) and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- tracked player --------------------------------------------------------
# Any MCSR UserIdentifier: nickname, UUID or discord.[id]
MCSR_PLAYER=AwenRuns

# --- start date ------------------------------------------------------------
# Matches before this date are NEVER imported. ISO date (YYYY-MM-DD).
START_DATE=2026-10-03

# Optional: minutes to shift UTC when deciding which calendar day a match is on
# (and when rendering the Date column). 60 = UTC+1, 120 = UTC+2. Default 0.
UTC_OFFSET_MINUTES=0

# --- MCSR Ranked API (optional) -------------------------------------------
# Only needed for the expanded rate limit. Not required for normal syncs.
MCSR_PRIVATE_KEY=

# --- spreadsheet backend ---------------------------------------------------
# google = Google Sheets (default), file = local JSON/CSV, memory = throw-away
MCSR_BACKEND=google

# Existing spreadsheet to use. Leave empty to let the CLI create one.
SPREADSHEET_ID=
# Title used when the CLI creates a brand new spreadsheet.
SPREADSHEET_TITLE=MCSR 1000 Runs - AwenRuns

# file-backend output directory (relative to mcsr-1000-runs/)
FILE_BACKEND_DIR=out/sheet

# --- Google authentication (OAuth refresh-token flow, recommended) --------
# Create an OAuth client (Desktop app) in Google Cloud Console with the
# Google Sheets API enabled, then mint a refresh token once (see README).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Google authentication (service account, alternative) -----------------
# Path to a service-account JSON key, or the JSON itself.
# Remember to share the spreadsheet with the service-account email.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Google authentication (static access token, testing only) ------------
# Short lived (1 hour). Handy for a one-off run / CI smoke test.
GOOGLE_ACCESS_TOKEN=

# --- stream links (Runs sheet "Stream" block + Dashboard segment) ----------
# Twitch / YouTube handles written as links below the last run row of the
# Runs sheet and mirrored as a segment at the bottom of the Dashboard.
# Both default to MCSR_PLAYER when left empty.
TWITCH_HANDLE=
YOUTUBE_HANDLE=

# Optional YouTube Data API v3 key (YouTube Data API v3 -> API key).
# When set, every sync / init-sheet looks up the channel's latest upload and
# writes it as the "Latest VOD" link. Best-effort: on failure the row is
# simply omitted, the sync still succeeds. Leave empty to skip the lookup.
YOUTUBE_API_KEY=

# --- sync behaviour --------------------------------------------------------
# Exclude decayed "matches" from the MCSR match list (recommended: true)
EXCLUDE_DECAYED=true
# Re-fetch and reconcile API-owned fields for matches newer than N days
RECONCILE_DAYS=3
# Extra seasons to rescan during incremental sync (safety margin for the
# pre-season gap where matches can be labelled with the upcoming season)
INCREMENTAL_SEASON_LOOKBACK=1
# Upper bound on Runs! rows the tool will maintain (filters / validation range)
SHEET_ROW_CAPACITY=2500
# Where the raw API cache / sync state live (relative to mcsr-1000-runs/)
DATA_DIR=data
